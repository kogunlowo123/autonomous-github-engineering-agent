# Copy to .env and adjust. Every variable is optional. Defaults are conservative: dry run,
# draft pull requests, approval label required.

# --- Mode ---------------------------------------------------------------------
GHAGENT_DRY_RUN=true
GHAGENT_DRAFT_PR=true

# --- GitHub -------------------------------------------------------------------
# GITHUB_TOKEN is also accepted. A dry run needs only read access to issues.
GHAGENT_GITHUB_TOKEN=
GHAGENT_GITHUB_API_URL=https://api.github.com
GHAGENT_CLONE_URL_TEMPLATE=https://github.com/{repo}.git
# Push to a fork instead of origin:
# GHAGENT_PUSH_URL=https://github.com/you/demo.git
# GHAGENT_PR_HEAD_OWNER=you
GHAGENT_COMMITTER_NAME=ghagent
GHAGENT_COMMITTER_EMAIL=ghagent@users.noreply.github.com

# --- Trigger policy -------------------------------------------------------------
GHAGENT_REQUIRED_LABEL=ghagent:approved
# JSON list; empty allows any author
GHAGENT_ALLOWED_AUTHORS=[]

# --- Model (needed by the coder) ------------------------------------------------
# llm_provider: none | openai | anthropic
GHAGENT_LLM_PROVIDER=none
GHAGENT_OPENAI_API_KEY=
GHAGENT_OPENAI_CHAT_MODEL=gpt-4o
GHAGENT_ANTHROPIC_API_KEY=
GHAGENT_ANTHROPIC_MODEL=claude-sonnet-5
GHAGENT_ANTHROPIC_MAX_TOKENS=8000

# --- Change limits ----------------------------------------------------------------
GHAGENT_MAX_FILES=5
GHAGENT_MAX_DIFF_LINES=400
GHAGENT_MAX_FILE_BYTES=200000
GHAGENT_MAX_CONTEXT_CHARS=60000
GHAGENT_MAX_ATTEMPTS=2
GHAGENT_BRANCH_PREFIX=ghagent/

# --- Tests ---------------------------------------------------------------------------
# JSON list, run inside the clone
GHAGENT_TEST_COMMAND=["python", "-m", "pytest", "-q"]
GHAGENT_TEST_TIMEOUT_SECONDS=600
GHAGENT_REQUIRE_GREEN_BASELINE=true

# --- Output ---------------------------------------------------------------------------
GHAGENT_WORK_DIR=.ghagent/work
GHAGENT_OUT_DIR=.ghagent/runs
GHAGENT_PR_FOOTER=Opened automatically by ghagent. Review the diff carefully before merging.

# --- Networking -----------------------------------------------------------------------
GHAGENT_HTTP_TIMEOUT_SECONDS=30
GHAGENT_RETRY_ATTEMPTS=3
GHAGENT_RETRY_MIN_WAIT=0.5
GHAGENT_RETRY_MAX_WAIT=8
GHAGENT_GIT_TIMEOUT_SECONDS=300

# --- Logging ----------------------------------------------------------------------------
GHAGENT_LOG_LEVEL=WARNING
GHAGENT_LOG_JSON=true
